# ============================================================
# Smart Recycling Assistant - Backend Environment Template
# Copy this file to `.env` and fill in real values locally.
# NEVER commit the real `.env` file.
# ============================================================

# ---------- Application ----------
APP_NAME="Smart Recycling Assistant API"
APP_VERSION="0.1.0"
APP_ENV="development"          # development | staging | production
DEBUG=true
API_V1_PREFIX="/api/v1"

# ---------- Server ----------
HOST="127.0.0.1"
PORT=8000

# ---------- CORS ----------
# Comma-separated list of allowed frontend origins.
# Example for local dev: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
...
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
# ---------- Database (Stage 5) ----------
DATABASE_URL="sqlite:///./smart_recycling.db"

# ---------- Google Gemini (Stage 4) ----------
# Leave empty for now. Get a key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.7-flash"

# ---------- AI model paths (Stage 2) ----------
CLASSIFICATION_MODEL_PATH=""
CLASSIFICATION_MODEL_ENABLED=false

# ---------- File upload limits (Stage 3) ----------
MAX_UPLOAD_SIZE_MB=8
ALLOWED_IMAGE_TYPES="image/jpeg,image/png,image/webp"
